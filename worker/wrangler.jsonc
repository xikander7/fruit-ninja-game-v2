{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honeys-slash-and-splash-scores",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honeys-slash-and-splash-scores",
      "database_id": "replace-during-deployment",
      "migrations_dir": "migrations"
    }
  ]
}
